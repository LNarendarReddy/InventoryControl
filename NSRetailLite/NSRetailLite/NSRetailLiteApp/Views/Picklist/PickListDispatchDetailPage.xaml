<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NSRetailLiteApp.Views.Picklist.PickListDispatchDetailPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" 
             Title="Add FT Dispatch item" x:Name="pickListDispatchDetailPage" Loaded="pickListDispatchDetailPage_Loaded">
    <Grid ColumnDefinitions="*">
        <Grid Margin="20" ColumnDefinitions="auto, *" RowDefinitions="auto, auto, auto, auto, auto, auto, auto" RowSpacing="10" ColumnSpacing="10">

            <Label Text="Tray #" Grid.Row="0" Grid.Column="0"  VerticalTextAlignment="Center"/>
            <Entry Text="{Binding Path=PickListDispatchDetailModelObj.TrayNumber, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" Placeholder="Enter Tray #"
                   x:Name="txtTrayNumber">
                <Entry.Behaviors>
                    <toolkit:SelectAllTextBehavior />
                </Entry.Behaviors>
            </Entry>
            
            <Grid ColumnDefinitions="*, Auto" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">

                <Entry Placeholder="EAN Code"  Text="{Binding Path=PickListDispatchDetailModelObj.ItemCode, Mode=TwoWay}"
               ClearButtonVisibility="WhileEditing" ReturnType="Done"
               ReturnCommand="{Binding Path=BindingContext.LoadItemCommand, Source={x:Reference pickListDispatchDetailPage}}" Keyboard="Numeric"
               x:Name="txtItemCode">
                    <Entry.Behaviors>
                        <toolkit:SelectAllTextBehavior />
                        <toolkit:EventToCommandBehavior
                    EventName="Completed"
                    Command="{Binding Path=BindingContext.LoadItemCommand, Source={x:Reference pickListDispatchDetailPage}}" />
                    </Entry.Behaviors>
                </Entry>
                <!--<ImageButton Source="camera.png" Command="{Binding Path=BindingContext.ScanCommand, Source={x:Reference AddItemPage}}" 
                     Margin="10, 0, 0, 0" WidthRequest="40" Grid.Column="1"/>-->
            </Grid>
            <Entry Placeholder="Item Name"  IsReadOnly="True" Text="{Binding Path=PickListDispatchDetailModelObj.ItemName, Mode=TwoWay}"
                   Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"/>
            
            <Label Grid.Row="3" Grid.Column="0" Text="SKU Code" VerticalTextAlignment="Center"/>
            <Entry Placeholder="SKU Code"  IsReadOnly="True" Text="{Binding Path=PickListDispatchDetailModelObj.SKUCode, Mode=TwoWay}"
                   Grid.Row="3" Grid.Column="1"/>

            <Label Grid.Row="4" Grid.Column="0" Text="MRP" VerticalTextAlignment="Center"/>
            <Entry Placeholder="MRP" IsReadOnly="True" Text="{Binding Path=PickListDispatchDetailModelObj.MRP, Mode=TwoWay}" Grid.Row="4" Grid.Column="1"/>

            <Label Text="Quantity" FontSize="Small" VerticalTextAlignment="Center" Grid.Row="5" Grid.Column="0" />
            <Entry Text="{Binding Path=PickListDispatchDetailModelObj.Quantity, Mode=TwoWay}"  Grid.Row="5" Grid.Column="1"  Keyboard="Numeric">
                <Entry.Behaviors>
                    <toolkit:NumericValidationBehavior InvalidStyle="{StaticResource InvalidEntryStyle}" ValidStyle="{StaticResource ValidEntryStyle}"
                            Flags="ValidateOnValueChanged" MaximumDecimalPlaces="0" MaximumValue="9999"/>
                    <toolkit:SelectAllTextBehavior />
                </Entry.Behaviors>
            </Entry>

            
            <Button Text="Save" WidthRequest="120" Command="{Binding Path=SaveCommand}" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" />
            
        </Grid>
    </Grid>
</ContentPage>